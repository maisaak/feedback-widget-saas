# Optional. When unset, the app uses the embedded PGlite database and needs
# no external services at all. Set it to run against Postgres (Neon, Supabase,
# local docker, ...) in production.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_widget

# Base URL used by the widget when `apiUrl` is not passed explicitly.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional outbound webhook fired for every new feedback item.
# FEEDBACK_WEBHOOK_URL=https://example.com/hooks/feedback

# Optional location for the embedded database files (defaults to ./.data/pglite).
# PGLITE_DATA_DIR=./.data/pglite
