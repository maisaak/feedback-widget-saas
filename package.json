{
  "name": "@feedback-widget/root",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "corepack pnpm build:widget && turbo run dev",
    "build:widget": "corepack pnpm --filter @feedback-widget/widget build",
    "db:seed": "corepack pnpm --filter @feedback-widget/database db:seed",
    "build": "corepack pnpm build:widget && turbo run build",
    "lint": "turbo run lint",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=20", "pnpm": ">=9" }
}
